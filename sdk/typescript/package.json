{
  "name": "@heimdall/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Heimdall TypeScript SDK workspace scaffold",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "6.2.12",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "rolldown": "1.2.13",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
