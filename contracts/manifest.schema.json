{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimdall.dev/contracts/v1/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z]",
      "not": {
        "pattern": "[^a-z0-9_-]"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "clients": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z]",
        "not": {
          "pattern": "[^a-z0-9_-]"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://[^/?#@\\s]+/[^?#\\s]*$",
              "not": {
                "pattern": "[\\s?#@]"
              }
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          }
        },
        "required": ["redirectUris"]
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(?:[.][a-z][a-z0-9_]*)*$",
        "not": {
          "pattern": "[^a-z0-9_.]"
        }
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z]",
        "not": {
          "pattern": "[^a-z0-9_]"
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(?:[.][a-z][a-z0-9_]*)*$",
          "not": {
            "pattern": "[^a-z0-9_.]"
          }
        },
        "minItems": 0,
        "maxItems": 256,
        "uniqueItems": true
      }
    },
    "ownerRole": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z]",
      "not": {
        "pattern": "[^a-z0-9_]"
      }
    },
    "delegation": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z]",
        "not": {
          "pattern": "[^a-z0-9_]"
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z]",
          "not": {
            "pattern": "[^a-z0-9_]"
          }
        },
        "minItems": 0,
        "maxItems": 128,
        "uniqueItems": true
      }
    }
  },
  "required": [
    "schemaVersion",
    "productId",
    "version",
    "clients",
    "permissions",
    "roles",
    "ownerRole",
    "delegation"
  ]
}
