{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimdall.dev/contracts/v1/storage-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "databaseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "state": {
      "enum": ["ready", "migrating"]
    },
    "readers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": ["min", "max"]
    },
    "writers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": ["min", "max"]
    },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "checksum": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "not": {
              "pattern": "[^a-f0-9]"
            }
          }
        },
        "required": ["version", "checksum"]
      }
    }
  },
  "required": ["schemaVersion", "databaseVersion", "state", "readers", "writers", "migrations"]
}
