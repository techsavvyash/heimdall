{
  "config": {
    "schemaVersion": 1,
    "productId": "ledger",
    "environment": "production",
    "issuer": "https://id.example.com",
    "audience": "ledger-api",
    "clientId": "client-1",
    "zitadelProjectId": "project-1",
    "openfga": {
      "url": "https://fga.example.com",
      "storeId": "store-1",
      "modelId": "model-1"
    },
    "manifestVersion": 1,
    "clientKey": "web"
  },
  "manifest": {
    "schemaVersion": 1,
    "productId": "ledger",
    "version": 1,
    "clients": {
      "web": {
        "redirectUris": ["https://ledger.example.com/auth/callback"]
      }
    },
    "permissions": ["invoice.read", "invoice.approve", "members.manage"],
    "roles": {
      "viewer": ["invoice.read"],
      "approver": ["invoice.read", "invoice.approve"],
      "admin": ["invoice.read", "members.manage"],
      "owner": ["invoice.read", "invoice.approve", "members.manage"]
    },
    "ownerRole": "owner",
    "delegation": {
      "admin": ["viewer", "approver"],
      "owner": ["viewer", "approver", "admin"]
    }
  },
  "cases": [
    {
      "name": "production",
      "valid": true
    },
    {
      "name": "unknown config field",
      "config": [[["secret"], "do-not-log"]],
      "valid": false
    },
    {
      "name": "wrong product",
      "config": [[["productId"], "support"]],
      "valid": false
    },
    {
      "name": "wrong version",
      "config": [[["manifestVersion"], 2]],
      "valid": false
    },
    {
      "name": "unknown client",
      "config": [[["clientKey"], "mobile"]],
      "valid": false
    },
    {
      "name": "encoded traversal",
      "config": [[["openfga", "url"], "https://fga.example.com/%2e%2e/admin"]],
      "valid": false
    },
    {
      "name": "credential URL",
      "config": [[["issuer"], "https://secret@id.example.com"]],
      "valid": false
    },
    {
      "name": "profile mismatch",
      "config": [[["transportProfile"], "loopback"]],
      "valid": false
    },
    {
      "name": "unknown owner",
      "manifest": [[["ownerRole"], "missing"]],
      "valid": false
    },
    {
      "name": "undeclared permission",
      "manifest": [[["roles", "viewer"], ["unknown.permission"]]],
      "valid": false
    },
    {
      "name": "duplicate grants",
      "manifest": [
        [
          ["roles", "viewer"],
          ["invoice.read", "invoice.read"]
        ]
      ],
      "valid": false
    },
    {
      "name": "owner delegation",
      "manifest": [[["delegation", "admin"], ["owner"]]],
      "valid": false
    },
    {
      "name": "unknown delegation actor",
      "manifest": [[["delegation", "nobody"], ["viewer"]]],
      "valid": false
    },
    {
      "name": "unknown delegation target",
      "manifest": [[["delegation", "admin"], ["nobody"]]],
      "valid": false
    },
    {
      "name": "empty clients",
      "manifest": [[["clients"], {}]],
      "valid": false
    },
    {
      "name": "empty roles",
      "manifest": [[["roles"], {}]],
      "valid": false
    },
    {
      "name": "null delegation",
      "manifest": [[["delegation"], null]],
      "valid": false
    },
    {
      "name": "array masquerading as roles",
      "manifest": [[["roles"], []]],
      "valid": false
    },
    {
      "name": "duplicate redirects",
      "manifest": [
        [
