{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimdall.dev/contracts/v1/enterprise-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "clientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "organizationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "upstreamSubject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "providerSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "protocol": {
      "enum": ["saml", "oidc"]
    },
    "authTime": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "verifiedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "productId",
    "environment",
    "issuer",
    "subject",
    "clientId",
    "tenantId",
    "organizationId",
    "policyVersion",
    "providerId",
    "upstreamSubject",
    "providerSessionId",
    "protocol",
    "authTime",
    "verifiedAt"
  ]
}
