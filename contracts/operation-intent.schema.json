{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimdall.dev/contracts/v1/operation-intent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "kind": {
      "enum": ["create_workspace", "add_member", "remove_member", "assign_roles", "transfer_owner"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["issuer", "subject"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["issuer", "subject"]
    },
    "workspaceId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "not": {
          "pattern": "[^a-z0-9_]"
        },
        "pattern": "^[a-z]"
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "manifestVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "required": [
    "schemaVersion",
    "productId",
    "environment",
    "kind",
    "actor",
    "target",
    "workspaceId",
    "name",
    "roles",
    "manifestVersion"
  ]
}
