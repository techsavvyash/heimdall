{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimdall.dev/contracts/v1/cursor-payload.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "workspace_discovery"
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "position": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "productId",
    "environment",
    "principal",
    "modelId",
    "position",
    "issuedAt",
    "expiresAt"
  ]
}
