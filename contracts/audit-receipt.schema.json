{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimdall.dev/contracts/v1/audit-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "not": {
        "pattern": "[^a-f0-9]"
      }
    },
    "recordedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "productId",
    "environment",
    "payloadDigest",
    "recordedAt"
  ]
}
