{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tests/integration/*.mjs"],
      "project": ["scripts/**/*.mjs", "tests/integration/**/*.mjs"]
    },
    "sdk/typescript": {
      "project": ["src/**/*.ts", "*.config.ts"]
    }
  },
  "ignoreBinaries": ["go"],
  "ignoreWorkspaces": ["docs"]
}
